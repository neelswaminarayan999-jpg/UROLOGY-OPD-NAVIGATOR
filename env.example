# Required only on the backend host (never commit .env)
GEMINI_API_KEY=replace_me
# Current default Gemini model for multimodal investigation analysis.
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
# Use the exact production frontend origin once known; * is acceptable only during initial testing.
ALLOWED_ORIGIN=*
RATE_LIMIT_PER_10MIN=30

# Optional: local test/mock endpoint only; leave unset in production.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
